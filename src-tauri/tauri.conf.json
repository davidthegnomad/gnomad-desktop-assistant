{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gnomad",
  "version": "0.1.0-alpha",
  "identifier": "com.gnomadstudio.gnomad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gnomad",
        "width": 600,
        "height": 920,
        "minWidth": 480,
        "minHeight": 400,
        "maxWidth": 1600,
        "maxHeight": 1200,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        },
        "hiddenTitle": true,
        "transparent": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$TEMP/**", "$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Built with ❤️ by Gnomad Studio 🦙",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "section": "utils",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ],
        "files": {
          "/usr/share/doc/gnomad/README.md": "../../README.md"
        }
      },
      "rpm": {
        "release": "1",
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3"
        ],
        "files": {
          "/usr/share/doc/gnomad/README.md": "../../README.md"
        }
      }
    }
  }
}
