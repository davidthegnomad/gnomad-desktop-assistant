{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gnomad",
  "version": "0.1.0",
  "identifier": "com.gnomadstudio.gnomad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gnomad",
        "width": 1060,
        "height": 780,
        "minWidth": 520,
        "minHeight": 420,
        "maxWidth": 1600,
        "maxHeight": 1200,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Built with ❤️ by Gnomad Studio 🦙",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
