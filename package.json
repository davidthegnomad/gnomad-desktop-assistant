{
  "name": "gnomad",
  "private": true,
  "version": "0.2.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:embedded": "tauri dev -- --features embedded-llm",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build",
    "tauri:build:linux": "tauri build --bundles deb,rpm,appimage",
    "tauri:build:linux:deb": "tauri build --bundles deb",
    "tauri:build:linux:rpm": "tauri build --bundles rpm",
    "tauri:build:linux:appimage": "tauri build --bundles appimage",
    "tauri:build:linux:arm64": "tauri build --bundles deb,appimage --target aarch64-unknown-linux-gnu",
    "pack:flatpak": "bash packaging/flatpak/build.sh",
    "pack:snap": "bash packaging/snap/build.sh",
    "setup:updater-keys": "bash scripts/setup-updater-keys.sh",
    "verify:updater": "bash scripts/verify-updater-pubkey.sh",
    "download:gguf": "bash scripts/download-gguf-model.sh",
    "notarize:macos": "bash scripts/notarize-macos.sh",
    "tauri:build:win": "tauri build --bundles msi,nsis",
    "docs:export": "node scripts/export-docs.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "marked": "^18.0.4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
